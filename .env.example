# Copy of the settings the app reads from .env. No real values here.
# Do not copy this file by hand. Run: python setup_env.py
#
# A long random secret that signs the sign-in cookies. At least 32 characters.
SECRET_KEY=
# 32 random bytes, base64-encoded. Encrypts sealed consultations. Never change it:
# without it, sealed records cannot be opened. Print it with export_sealed_key.py.
SEALED_DATA_KEY=
# 1 turns on Flask debug mode. Leave it 0 on shared health-center computers.
IDS_DEBUG=0
# 1 opens the system to other devices on the Wi-Fi, over HTTPS only. Run python setup_https.py first.
IDS_NETWORK=0
# The port the system listens on. Empty means 5001.
IDS_PORT=
# Optional. The Semaphore key for sending SMS. Without it, messages are saved but not sent
# (Settings and SMS Notifications say "SMS mode: Simulated"). Set it, then restart.
SEMAPHORE_API_KEY=
